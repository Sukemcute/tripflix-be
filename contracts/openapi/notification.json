{
  "openapi": "3.0.3",
  "info": {
    "title": "Tripflix Notification API",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/notifications": {
      "get": {
        "operationId": "listNotifications",
        "summary": "Danh sách thông báo của người đăng nhập",
        "parameters": [
          {
            "name": "tab",
            "in": "query",
            "description": "Đơn hàng gồm booking.*. Tương tác gồm comment.* và reaction.*.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "orders",
                "interactions"
              ],
              "default": "all"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationsPage"
                }
              }
            }
          },
          "400": {
            "description": "Tham số không hợp lệ"
          },
          "401": {
            "description": "Cần access token hợp lệ"
          }
        }
      }
    },
    "/notifications/unread-count": {
      "get": {
        "operationId": "getUnreadNotificationCount",
        "summary": "Số chưa đọc trên tất cả tab",
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadCount"
                }
              }
            }
          },
          "401": {
            "description": "Cần access token hợp lệ"
          }
        }
      }
    },
    "/notifications/{id}/read": {
      "post": {
        "operationId": "markNotificationRead",
        "summary": "Đánh dấu một thông báo đã đọc",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadCount"
                }
              }
            }
          },
          "400": {
            "description": "Tham số không hợp lệ"
          },
          "401": {
            "description": "Cần access token hợp lệ"
          },
          "404": {
            "description": "Không tìm thấy thông báo thuộc người gọi"
          }
        }
      }
    },
    "/notifications/read-all": {
      "post": {
        "operationId": "markAllNotificationsRead",
        "summary": "Đánh dấu đã đọc tới thông báo mới nhất đã thấy",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadAllRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadCount"
                }
              }
            }
          },
          "400": {
            "description": "Tham số không hợp lệ"
          },
          "401": {
            "description": "Cần access token hợp lệ"
          },
          "404": {
            "description": "Không tìm thấy thông báo thuộc người gọi"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Notification": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title",
          "body",
          "link",
          "data",
          "createdAt",
          "readAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "link": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "readAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "NotificationsPage": {
        "type": "object",
        "required": [
          "items",
          "unreadCount",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notification"
            }
          },
          "unreadCount": {
            "type": "integer",
            "minimum": 0
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "UnreadCount": {
        "type": "object",
        "required": [
          "unreadCount"
        ],
        "properties": {
          "unreadCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ReadAllRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "throughId": {
            "type": "string",
            "format": "uuid",
            "description": "ID thông báo mới nhất đã thấy. Bỏ trống để tương thích client cũ và đánh dấu toàn bộ."
          }
        }
      }
    }
  }
}
