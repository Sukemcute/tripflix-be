  "info": {
    "title": "Tripflix core-api",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "khang@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "maxLength": 50,
            "example": "Khang"
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "moderator",
              "superadmin"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "createdAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "khang@example.com"
          },
          "password": {
            "type": "string"
          },
          "deviceName": {
            "type": "string",
            "example": "Pixel 8"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenPairDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Số giây access token còn dùng được"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 50,
            "example": "Khang Nguyễn"
          }
        },
        "required": [
          "displayName"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "deviceName": {
            "type": "string",
            "nullable": true,
            "example": "Pixel 8"
          },
          "userAgent": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isCurrent": {
            "type": "boolean",
            "description": "Phiên của access token đang gọi"
          }
        },
        "required": [
          "id",
          "deviceName",
          "userAgent",
          "createdAt",
          "lastUsedAt",
          "isCurrent"
        ]
      },
      "JwksDto": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "keys"
        ]
      },
      "AdminUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "moderator",
              "superadmin"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "locked"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "createdAt",
          "status"
        ]
      },
      "AdminUserPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminUserDto"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ]
      },
      "GrantStaffDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "userId"
        ]
      },
      "CreateUploadDto": {
        "type": "object",
        "properties": {
          "mimeType": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/quicktime"
            ]
          },
          "fileSizeBytes": {
            "type": "number",
            "example": 25000000
          },
          "durationSec": {
            "type": "number",
            "example": 42.5,
            "description": "Làm tròn lên số nguyên. Tối đa 5 phút."
          }
        },
        "required": [
          "mimeType",
          "fileSizeBytes",
          "durationSec"
        ]
      },
      "SignedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number"
          },
          "url": {
            "type": "string",
            "description": "Link PUT ký sẵn, không gửi kèm header Authorization."
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "CreatedUploadDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignedPartDto"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "partSizeBytes": {
            "type": "number",
            "example": 10485760
          }
        },
        "required": [
          "parts",
          "expiresAt",
          "assetId",
          "partSizeBytes"
        ]
      },
      "MediaErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "MEDIA_TOO_LARGE"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ResignPartsDto": {
        "type": "object",
        "properties": {
          "partNumbers": {
            "example": [
              2,
              3
            ],
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "partNumbers"
        ]
      },
      "SignedPartsDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignedPartDto"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "parts",
          "expiresAt"
        ]
      }
    }
  }
}
