  "info": {
    "title": "Tripflix core-api",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "khang@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "maxLength": 50,
            "example": "Khang"
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "moderator",
              "superadmin"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "createdAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "khang@example.com"
          },
          "password": {
            "type": "string"
          },
          "deviceName": {
            "type": "string",
            "example": "Pixel 8"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenPairDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Số giây access token còn dùng được"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "JwksDto": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "keys"
        ]
      },
      "AdminRoomDayDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "total": {
            "type": "number"
          },
          "held": {
            "type": "number"
          },
          "sold": {
            "type": "number"
          },
          "remaining": {
            "type": "number",
            "description": "total - held - sold"
          },
          "price": {
            "type": "number",
            "description": "Giá gốc một đêm (VND)"
          },
          "isStopSell": {
            "type": "boolean"
          },
          "isClosedToArrival": {
            "type": "boolean"
          },
          "isClosedToDeparture": {
            "type": "boolean"
          },
          "minLos": {
            "type": "number"
          },
          "maxLos": {
            "type": "number"
          }
        },
        "required": [
          "date",
          "total",
          "held",
          "sold",
          "remaining",
          "price",
          "isStopSell",
          "isClosedToArrival",
          "isClosedToDeparture",
          "minLos",
          "maxLos"
        ]
      },
      "UpdateRoomCalendarDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "example": "2026-12-01"
          },
          "to": {
            "type": "string",
            "format": "date",
            "example": "2026-12-31",
            "description": "Tính cả ngày này; tối đa 93 ngày"
          },
          "total": {
            "type": "number",
            "description": "Tổng số phòng mỗi ngày; không được nhỏ hơn số đã giữ + đã bán"
          },
          "price": {
            "type": "number",
            "description": "Giá gốc một đêm (VND), trước hệ số của gói giá"
          },
          "isStopSell": {
            "type": "boolean"
          },
          "isClosedToArrival": {
            "type": "boolean",
            "description": "Không nhận phòng vào ngày này"
          },
          "isClosedToDeparture": {
            "type": "boolean",
            "description": "Không trả phòng vào ngày này"
          },
          "minLos": {
            "type": "number",
            "minimum": 1,
            "maximum": 14
          },
          "maxLos": {
            "type": "number",
            "minimum": 1,
            "maximum": 14
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "UpdateCalendarResultDto": {
        "type": "object",
        "properties": {
          "updatedDays": {
            "type": "number",
            "example": 31
          }
        },
        "required": [
          "updatedDays"
        ]
      },
      "AdminFlightDayDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "total": {
            "type": "number"
          },
          "held": {
            "type": "number"
          },
          "sold": {
            "type": "number"
          },
          "remaining": {
            "type": "number"
          },
          "price": {
            "type": "number",
            "description": "Giá một vé (VND)"
          },
          "isStopSell": {
            "type": "boolean"
          }
        },
        "required": [
          "date",
          "total",
          "held",
          "sold",
          "remaining",
          "price",
          "isStopSell"
        ]
      },
      "UpdateFlightCalendarDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "example": "2026-12-01"
          },
          "to": {
            "type": "string",
            "format": "date",
            "example": "2026-12-31",
            "description": "Tính cả ngày này; tối đa 93 ngày"
          },
          "total": {
            "type": "number",
            "description": "Tổng số ghế mỗi ngày; không được nhỏ hơn số đã giữ + đã bán"
          },
          "price": {
            "type": "number",
            "description": "Giá một vé (VND), trước hệ số của gói giá"
          },
          "isStopSell": {
            "type": "boolean"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
    }
  }
}
