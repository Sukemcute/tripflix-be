  "info": {
    "title": "Tripflix core-api",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "khang@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "maxLength": 50,
            "example": "Khang"
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "moderator",
              "superadmin"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "createdAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "khang@example.com"
          },
          "password": {
            "type": "string"
          },
          "deviceName": {
            "type": "string",
            "example": "Pixel 8"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenPairDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Số giây access token còn dùng được"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "JwksDto": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "keys"
        ]
      },
      "ProvinceDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "da-nang"
          },
          "name": {
            "type": "string",
            "example": "Đà Nẵng"
          }
        },
        "required": [
          "slug",
          "name"
        ]
      },
      "StayDto": {
        "type": "object",
        "properties": {
          "checkIn": {
            "type": "string",
            "format": "date",
            "example": "2026-12-01"
          },
          "checkOut": {
            "type": "string",
            "format": "date",
            "example": "2026-12-03"
          },
          "nights": {
            "type": "number",
            "example": 2
          },
          "adults": {
            "type": "number",
            "example": 2
          }
        },
        "required": [
          "checkIn",
          "checkOut",
          "nights",
          "adults"
        ]
      },
      "HotelRatePlanQuoteDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "BB"
          },
          "name": {
            "type": "string",
            "example": "Kèm ăn sáng · huỷ miễn phí"
          },
          "meal": {
            "type": "string",
            "example": "breakfast"
          },
          "isRefundable": {
            "type": "boolean"
          },
          "freeCancelDays": {
            "type": "number",
            "description": "Huỷ miễn phí trước ngày nhận phòng bao nhiêu ngày"
          },
          "totalPrice": {
            "type": "number",
            "nullable": true,
            "description": "Cả kỳ ở, mọi phòng (VND)"
          },
          "pricePerNight": {
            "type": "number",
            "nullable": true,
            "description": "Một đêm một phòng (VND)"
          }
        },
        "required": [
          "code",
          "name",
          "meal",
          "isRefundable",
          "freeCancelDays",
          "totalPrice",
          "pricePerNight"
        ]
      },
      "HotelRoomOfferDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "example": "P-h-dn-01--DLX",
            "description": "Mã dùng khi đặt chỗ"
          },
          "name": {
            "type": "string",
            "example": "Deluxe hướng vườn"
          },
          "maxGuests": {
            "type": "number"
          },
          "roomsNeeded": {
            "type": "number",
            "description": "Số phòng cần cho số khách đã chọn"
          },
          "isAvailable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "NOT_ON_SALE",
              "STOP_SELL",
              "CTA",
              "CTD",
              "MIN_LOS",
              "MAX_LOS",
              "SOLD_OUT",
              "NOT_ENOUGH_ROOMS"
            ],
            "nullable": true
          },
          "remaining": {
            "type": "number",
            "nullable": true,
            "description": "Số phòng thật còn lại suốt kỳ ở"
          },
          "ratePlans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HotelRatePlanQuoteDto"
            }
          }
        },
        "required": [
          "productId",
          "name",
          "maxGuests",
          "roomsNeeded",
          "isAvailable",
          "reason",
          "remaining",
          "ratePlans"
        ]
      },
      "CalendarDayDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "priceFrom": {
            "type": "number",
            "nullable": true,
            "description": "Giá một đêm rẻ nhất ngày đó (VND)"
          },
          "isAvailable": {
            "type": "boolean"
          }
        },
        "required": [
          "date",
          "priceFrom",
          "isAvailable"
        ]
      },
      "HotelDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "P-h-dn-01"
          },
          "name": {
            "type": "string",
            "example": "Vinpearl Beach Đà Nẵng"
          },
          "province": {
            "$ref": "#/components/schemas/ProvinceDto"
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "stars": {
            "type": "number",
            "nullable": true,
            "minimum": 1,
            "maximum": 5
          },
          "brand": {
            "type": "string",
            "nullable": true
          },
          "style": {
            "type": "string",
            "nullable": true
          },
          "thumbnail": {
            "type": "string",
            "nullable": true,
            "description": "Đường dẫn ảnh đại diện"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stay": {
            "$ref": "#/components/schemas/StayDto"
          },
          "priceFrom": {
            "type": "number",
            "nullable": true,
            "description": "Giá một đêm rẻ nhất cho kỳ ở này (VND)"
          },
          "isAvailable": {
            "type": "boolean"
          },
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HotelRoomOfferDto"
            }
          },
          "calendar": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarDayDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "province",
          "city",
          "stars",
          "brand",
          "style",
          "thumbnail",
          "images",
          "stay",
          "priceFrom",
          "isAvailable",
          "rooms",
          "calendar"
        ]
      }
    }
  }
}
