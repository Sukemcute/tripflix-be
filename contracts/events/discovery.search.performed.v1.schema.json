{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "surface": {
      "type": "string",
      "enum": [
        "explore",
        "posts"
      ]
    },
    "placeIds": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intent": {
      "type": [
        "string",
        "null"
      ]
    },
    "budgetMax": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "postType": {
      "type": [
        "string",
        "null"
      ]
    },
    "resultCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "userId",
    "surface",
    "placeIds",
    "intent",
    "budgetMax",
    "postType",
    "resultCount"
  ],
  "additionalProperties": false
}
