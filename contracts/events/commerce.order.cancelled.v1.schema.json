{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "userId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "total": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "refundAmount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "feeAmount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "confirmationCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "contactName": {
      "type": [
        "string",
        "null"
      ]
    },
    "contactEmail": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "orderId",
    "userId",
    "total",
    "refundAmount",
    "feeAmount",
    "confirmationCode",
    "contactName",
    "contactEmail"
  ],
  "additionalProperties": false
}
