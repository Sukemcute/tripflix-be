{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assetId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "hlsPrefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "policy": {
      "type": "string",
      "const": "uniform-v1"
    },
    "durationMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 300000
    },
    "frames": {
      "minItems": 1,
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestampMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 300000
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "timestampMs",
          "key"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "assetId",
    "requestId",
    "hlsPrefix",
    "policy",
    "durationMs",
    "frames"
  ],
  "additionalProperties": false
}
