# Chép thành deploy/.env (không commit). docker compose tự đọc file này.

# Đổi cổng nếu máy đã có Postgres, Redis chạy sẵn
PG_PORT=5432
REDIS_PORT=6379
LOG_LEVEL=debug

# Đường dẫn tới 2 repo còn lại (mặc định: clone cạnh tripflix-be)
AI_REPO=../../tripflix-ai
FE_REPO=../../tripflix-fe

# Media dev: bucket S3 thật, mỗi người một thư mục dev/<tên>/ (xem deploy/aws/README.md)
DEV_NAME=trang
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=tripflix-media-dev
MEDIA_CDN_URL=https://d399hxccn6y84z.cloudfront.net

# Kiểm duyệt caption/ảnh: tạo service client core-api -> ai-service, giữ secret ngoài Git.
# Bật profile ai và cấu hình các biến này để Core gọi AI. Thiếu config: giữ trạng thái chờ thử lại.
AI_SERVICE_URL=http://ai-service:8000
CORE_API_INTERNAL_URL=http://localhost:3000
MODERATION_SERVICE_CLIENT_SECRET=

# ai-service + ai-summary-worker (chỉ cần khi chạy pnpm stack:ai / stack:full)
# LLM_PROVIDER bắt buộc: fake (code ở máy, không tốn tiền) | deepseek
LLM_PROVIDER=fake
LLM_MODEL=
# Key DeepSeek chỉ đặt trong deploy/.env, không commit
DEEPSEEK_API_KEY=
# Secret của service client ai-service (core: auth:create-service-client, chỉ in một lần)
SERVICE_CLIENT_SECRET=
# true = worker không gọi LLM (tắt khẩn cấp)
SUMMARY_LLM_KILL=false

# Trợ lý Tripi (/chat của ai-service). false = không gọi LLM, Tripi chỉ tìm theo từ khoá (máy không có key vẫn chạy).
# true thì cần OPENAI_API_KEY (Controller) và DEEPSEEK_API_KEY ở trên (Responder); key chỉ đặt trong deploy/.env.
CHAT_LLM_ENABLED=false
OPENAI_API_KEY=
CHAT_CONTROLLER_PROVIDER=openai
CHAT_CONTROLLER_MODEL=gpt-5-nano
CHAT_RESPONDER_PROVIDER=deepseek
# Trống = mặc định của code (minimal). gpt-5.6-luna không nhận minimal: đặt none.
OPENAI_REASONING_EFFORT=
# Chuỗi ngẫu nhiên dài để băm IP khách thành khoá đếm lượt
CHAT_IDENTITY_SALT=

# Tìm khám phá (TF13, deploy/SERVER.md mục Tìm kiếm). Key riêng: openssl rand -hex 32. postgres = quay lui, không dùng Typesense.
TYPESENSE_API_KEY=
SEARCH_BACKEND=typesense

# Web Push (notification-service). Khóa VAPID riêng chỉ đặt trên server.
WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notifications@example.com
