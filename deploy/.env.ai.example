# Config AI trên server: ai-service, ai-summary-worker, ai-label-worker cùng đọc file deploy/.env.ai (không commit).
# Bảo sửa qua ai-config.sh (deploy/SERVER.md, mục Config AI); sửa xong cả 3 service được tạo lại.
# Giá trị dưới đây là mặc định trước khi tách file. Biến mới của tripflix-ai thêm thẳng vào .env.ai, không cần sửa compose.
# Địa chỉ nội bộ (CORE_API_URL, REDIS_URL), CORS, FORWARDED_ALLOW_IPS, secret service client và số luồng do
# compose.server.yaml đặt và ghi đè file này. Máy local vẫn dùng deploy/.env như cũ.

LOG_LEVEL=INFO

# Kiểm duyệt (POST /moderate): thiếu key thì /moderate trả 503 và core giữ bước lọc regex.
OPENAI_API_KEY=
# ViSoBERT INT8 chạy cạnh OpenAI moderation, cần AI_TAG từ sha-eadf699. Bận hoặc quá 1,5 giây thì dùng riêng kết quả OpenAI.
IS_VISOBERT_ENABLED=false

# Tóm tắt (ai-summary-worker) và Responder của Tripi. Thiếu key thì worker tóm tắt dừng lúc khởi động.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Bắt buộc với 2 worker: fake | deepseek | openai | anthropic.
LLM_PROVIDER=deepseek
# Trống thì dùng model mặc định của provider.
LLM_MODEL=
# true = không gọi DeepSeek (tắt khẩn cấp, ví dụ khi tốn tiền bất thường).
SUMMARY_LLM_KILL=false
# false = chỉ tóm tắt và gắn nhãn bằng luật, không chạy bộ phân loại (tắt khi model có vấn đề).
CLASSIFIER_ENABLED=true

# Tripi v3 (TF31, POST /chat): false thì Tripi chỉ tìm kiếm thường, không gọi LLM.
CHAT_LLM_ENABLED=false
# Controller (OpenAI) chọn công cụ, Responder (DeepSeek) viết câu trả lời.
CHAT_CONTROLLER_PROVIDER=openai
CHAT_CONTROLLER_MODEL=gpt-5-nano
# Giá USD mỗi 1 triệu token của Controller, xác nhận lại khi đổi model. Không để rỗng:
# ai-service đọc "" thành lỗi và không khởi động, kéo theo /moderate (ai-config.sh từ chối giá rỗng).
CHAT_CONTROLLER_PRICE_INPUT=0.05
CHAT_CONTROLLER_PRICE_CACHED_INPUT=0.005
CHAT_CONTROLLER_PRICE_OUTPUT=0.4
# Trống thì dùng mặc định của code (minimal). gpt-5.6-luna không nhận minimal, phải đặt none,
# nếu không mọi lượt gọi Controller lỗi 400 và Tripi chỉ trả "chưa tìm thấy kết quả".
OPENAI_REASONING_EFFORT=
CHAT_RESPONDER_PROVIDER=deepseek
# Băm IP của khách để tính hạn mức: openssl rand -hex 32. Mỗi môi trường một chuỗi; đổi thì hạn mức khách tính lại từ đầu.
CHAT_IDENTITY_SALT=
# Trần chi tiêu USD/ngày của cả hệ thống. Hạn mức lượt, token, lượt chạy cùng lúc để mặc định trong code; cần thì thêm CHAT_*.
CHAT_SYSTEM_DAILY_USD=3
