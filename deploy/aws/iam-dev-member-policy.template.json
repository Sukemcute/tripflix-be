{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteOwnFolder",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::@BUCKET@/dev/@DEV_NAME@/*"
    },
    {
      "Sid": "ListBucketSoMissingFilesReturn404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::@BUCKET@"
    }
  ]
}
