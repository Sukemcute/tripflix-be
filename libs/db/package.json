{
  "name": "@tripflix/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "catalog:",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "catalog:",
    "drizzle-orm": "catalog:",
    "nestjs-cls": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@types/pg": "catalog:",
    "@nestjs/testing": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "rxjs": "^7.0.0"
  }
}
