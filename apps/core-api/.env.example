# Chép thành .env khi chạy core-api trên máy (pnpm dev). Trong Docker, compose tự đặt các biến này.
NODE_ENV=development
LOG_LEVEL=debug
# api: chỉ nhận request; worker: job, consumer, outbox relay; all: cả hai (dev)
APP_ROLE=all
PORT=3000
REDIS_URL=redis://localhost:6379

# Mỗi module một user Postgres, chỉ có quyền trên schema của mình (deploy/postgres/init).
DATABASE_URL_ACCESS=postgres://tf_access:tf_access_dev@localhost:5432/core
DATABASE_URL_CONTENT=postgres://tf_content:tf_content_dev@localhost:5432/core
DATABASE_URL_DISCOVERY=postgres://tf_discovery:tf_discovery_dev@localhost:5432/core
DATABASE_URL_ANALYTICS=postgres://tf_analytics:tf_analytics_dev@localhost:5432/core
DATABASE_URL_COMMERCE=postgres://tf_commerce:tf_commerce_dev@localhost:5432/commerce

# Access token (JWT ES256). Bỏ trống AUTH_JWT_PRIVATE_KEY khi dev: core-api tự sinh khoá tạm, token mất hiệu lực khi khởi động lại.
# Staging, demo: sinh khoá bằng `pnpm --filter @tripflix/core-api auth:keygen`, để trong secret, không commit.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_KID=
AUTH_JWT_ISSUER=tripflix-core
AUTH_JWT_AUDIENCE=tripflix
# Web, admin gọi API từ trình duyệt (CORS) và dùng cookie refresh token; cách nhau bởi dấu phẩy, không có / cuối.
AUTH_WEB_ORIGINS=http://localhost:3100,http://localhost:3200
# Trang đặt lại mật khẩu của web; link trong email là địa chỉ này kèm ?token=...
AUTH_PASSWORD_RESET_URL=http://localhost:3100/dat-lai-mat-khau

# Mật khẩu chung của 3 tài khoản mẫu tạo bởi `pnpm db:seed` (chỉ dùng ở máy local).
SEED_PASSWORD=tripflix-dev-123

# Media trên S3 (xem deploy/aws/README.md). Key AWS riêng từng người, chỉ ghi được dev/<tên>/, không commit.
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=tripflix-media-dev
S3_KEY_PREFIX=dev/unknown/
MEDIA_CDN_URL=https://d399hxccn6y84z.cloudfront.net
