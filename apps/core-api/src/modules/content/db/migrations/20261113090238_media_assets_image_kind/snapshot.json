        "name": "ck_media_assets_kind",
        "value": "\"kind\" in ('video', 'image')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "content",
        "table": "media_assets",
        "name": "ck_media_assets_dimensions",
        "value": "(\"width_px\" is null or \"width_px\" > 0) and (\"height_px\" is null or \"height_px\" > 0)",
        "entityType": "checks"
      }
    },
    {
      "op": "alter",
      "key": "columns\u0000[\"content\",\"media_assets\",\"duration_sec\"]",
      "set": {
        "notNull": false
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"content\",\"media_assets\",\"ck_media_assets_mime_type\"]",
      "set": {
        "value": "(\"kind\" = 'video' and \"mime_type\" in ('video/mp4', 'video/quicktime')) or (\"kind\" = 'image' and \"mime_type\" in ('image/jpeg', 'image/png', 'image/webp'))"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"content\",\"media_assets\",\"ck_media_assets_duration_sec\"]",
      "set": {
        "value": "(\"kind\" = 'video' and \"duration_sec\" is not null and \"duration_sec\" > 0) or (\"kind\" = 'image' and \"duration_sec\" is null)"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"content\",\"media_assets\",\"ck_media_assets_ready_has_playback\"]",
      "set": {
        "value": "\"kind\" = 'image' or \"status\" <> 'ready' or (\"hls_prefix\" is not null and \"aspect\" is not null)"
      }
    }
