# Chép thành .env khi chạy trên máy (pnpm dev).
NODE_ENV=development
LOG_LEVEL=debug
REDIS_URL=redis://localhost:6379
# Worker ghi file HLS lên S3, không nối PostgreSQL. Key AWS đặt ở AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
AWS_REGION=ap-southeast-2
S3_MEDIA_BUCKET=tripflix-media-dev
S3_KEY_PREFIX=dev/<tên>/
# Để trống thì lấy tên máy. Mỗi replica một tên để Redis chia việc.
VIDEO_WORKER_CONSUMER_NAME=
