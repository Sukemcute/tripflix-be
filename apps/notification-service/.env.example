# Chép thành .env khi chạy trên máy (pnpm dev). Trong Docker, compose tự đặt các biến này.
NODE_ENV=development
LOG_LEVEL=debug
PORT=3001
REDIS_URL=redis://localhost:6379
DATABASE_URL_NOTIFICATION=postgres://tf_notification:tf_notification_dev@localhost:5432/notification

# Kiểm access token bằng khoá công khai của core-api (module access). Phải khớp AUTH_JWT_* của core-api.
JWKS_URL=http://localhost:3000/.well-known/jwks.json
AUTH_JWT_ISSUER=tripflix-core
AUTH_JWT_AUDIENCE=tripflix

# Email (out-app). Dev: Mailpit nhận mọi email, xem ở http://localhost:8025.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Tripflix <no-reply@tripflix.local>
# Trang web mở từ nút "Khám phá ngay" trong email chào mừng.
WEB_APP_URL=http://localhost:3100
# Origin của web, admin được gọi /notifications từ trình duyệt (CORS), cách nhau dấu phẩy.
WEB_ORIGINS=http://localhost:3100,http://localhost:3200
# Consumer group "notification" nghe stream:core.*; mỗi replica một tên (bỏ trống thì dùng hostname).
NOTIFICATION_CONSUMER_ENABLED=true
NOTIFICATION_CONSUMER_NAME=
# Giãn nhịp quét để Redis không bị truy vấn liên tục khi SMTP lỗi.
NOTIFICATION_DLQ_REPLAY_INTERVAL_MS=60000
